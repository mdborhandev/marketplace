@{
    ViewData["Title"] = "Design System / UI Components";
}

<div class="pg-showcase">
    <div class="pg-page-shell">
        <nav aria-label="Breadcrumb">
            <ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li><li class="breadcrumb-item active" aria-current="page">Design System</li></ol>
        </nav>

        <section class="pg-section pb-3">
            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-end gap-4">
                <div><span class="pg-eyebrow">PoshakGhor / Foundation</span><h1 class="pg-display">Design System <span class="text-primary">/</span><br />UI Components</h1><p class="pg-lead mb-0">A considered language for fashion discovery, thoughtful essentials, and exceptional value. The same components adapt across both store experiences.</p></div>
                <div class="pg-theme-preview" aria-label="Choose a theme"><div class="small text-muted mb-2">Preview a storefront theme</div><div class="d-flex gap-2"><button type="button" class="btn btn-sm btn-outline-primary" data-theme-option="clearance" aria-pressed="false">Clearance Market</button><button type="button" class="btn btn-sm btn-outline-primary" data-theme-option="new-collections" aria-pressed="false">New Collections</button></div></div>
            </div>
        </section>

        <nav class="pg-showcase-nav" aria-label="Component sections">
            <a href="#foundations">Foundations</a><a href="#buttons">Buttons</a><a href="#products">Products</a><a href="#forms">Forms</a><a href="#commerce">Commerce</a><a href="#feedback">Feedback</a><a href="#navigation">Navigation</a><a href="#states">States</a>
        </nav>

        <section class="pg-showcase-section" id="foundations">
            <span class="pg-eyebrow">01 / Foundations</span><h2 class="pg-showcase-heading">Colour, type & rhythm</h2>
            <p class="small text-muted mb-3">Semantic colour tokens — the same values power controls, badges, borders and surfaces.</p>
            <div class="row g-2">
                <div class="col-6 col-md-4 col-xl-3"><div class="pg-token-swatch swatch-primary"><span>Primary · #806B78</span></div></div>
                <div class="col-6 col-md-4 col-xl-3"><div class="pg-token-swatch swatch-primary-hover"><span>Primary hover</span></div></div>
                <div class="col-6 col-md-4 col-xl-3"><div class="pg-token-swatch swatch-secondary"><span>Secondary</span></div></div>
                <div class="col-6 col-md-4 col-xl-3"><div class="pg-token-swatch swatch-background"><span>Background</span></div></div>
                <div class="col-6 col-md-4 col-xl-3"><div class="pg-token-swatch swatch-surface"><span>Surface</span></div></div>
                <div class="col-6 col-md-4 col-xl-3"><div class="pg-token-swatch swatch-neutral"><span>Neutral</span></div></div>
                <div class="col-6 col-md-4 col-xl-3"><div class="pg-token-swatch swatch-success"><span>Success</span></div></div>
                <div class="col-6 col-md-4 col-xl-3"><div class="pg-token-swatch swatch-warning"><span>Warning</span></div></div>
                <div class="col-6 col-md-4 col-xl-3"><div class="pg-token-swatch swatch-danger"><span>Danger</span></div></div>
                <div class="col-6 col-md-4 col-xl-3"><div class="pg-token-swatch swatch-info"><span>Info</span></div></div>
            </div>
            <div class="row align-items-end g-4 mt-3">
                <div class="col-lg-7"><span class="pg-eyebrow">Display / Georgia</span><div class="pg-showcase-heading mb-2">Made for the moments that matter.</div><p class="mb-0">Body / Public Sans — Clear, composed and comfortably readable at every size.</p></div>
                <div class="col-lg-5"><div class="pg-divider-label mb-3">Spacing scale</div><div class="d-flex flex-wrap gap-3 align-items-end"><div><div class="pg-space-swatch space-2"></div><small class="text-muted">2</small></div><div><div class="pg-space-swatch space-3"></div><small class="text-muted">3</small></div><div><div class="pg-space-swatch space-4"></div><small class="text-muted">4</small></div><div><div class="pg-space-swatch space-5"></div><small class="text-muted">5</small></div><div><div class="pg-space-swatch space-6"></div><small class="text-muted">6</small></div></div></div>
            </div>
        </section>

        <section class="pg-showcase-section" id="buttons">
            <span class="pg-eyebrow">02 / Actions</span><h2 class="pg-showcase-heading">Buttons & interaction</h2>
            <div class="d-flex flex-wrap align-items-center gap-2 mb-3"><button class="btn btn-primary">Shop collection</button><button class="btn btn-outline-primary">Explore details</button><button class="btn btn-soft">Save for later</button><button class="btn btn-primary" disabled>Unavailable</button><button class="btn btn-primary" data-demo-loading><span class="me-1">↗</span> Try loading</button><button class="btn btn-primary btn-icon" aria-label="Add to favourites">♡</button></div>
            <p class="small text-muted mb-0">Hover, keyboard focus, disabled and loading states are shown using shared Bootstrap-compatible variants.</p>
        </section>

        <section class="pg-showcase-section" id="products">
            <span class="pg-eyebrow">03 / Product discovery</span><h2 class="pg-showcase-heading">Product cards & merchandising</h2>
            <div class="row g-3" id="showcase-products">
                <div class="col-6 col-lg-4" data-product-item data-search-text="aarong edit everyday drape"><article class="pg-card h-100"><div class="pg-product-visual visual-plum"><span>New arrival</span></div><div class="pg-product-body"><div class="pg-product-brand">Aarong Edit</div><h3 class="pg-product-title">The everyday drape</h3><div class="d-flex justify-content-between align-items-center gap-2"><span class="pg-product-price">৳ 2,490</span><span class="pg-stock">In stock</span></div><button class="btn btn-primary w-100 mt-3">Add to bag</button></div></article></div>
                <div class="col-6 col-lg-4" data-product-item data-search-text="studio neel soft structure shirt clearance"><article class="pg-card h-100"><div class="pg-product-visual visual-cream"><span>Save 35%</span></div><div class="pg-product-body"><div class="pg-product-brand">Studio Neel</div><h3 class="pg-product-title">Soft structure shirt</h3><div class="d-flex justify-content-between align-items-center gap-2"><span class="pg-product-price">৳ 1,690 <del>৳ 2,600</del></span><span class="pg-stock low">Only 4 left</span></div><div class="pg-tier-pricing mt-2"><span>Buy 3+ pieces</span><strong>৳ 1,490 <small>/ each</small></strong></div><button class="btn btn-outline-primary w-100 mt-3">View offer</button></div></article></div>
                <div class="col-6 col-lg-4" data-product-item data-search-text="poshakghor select weekend linen set"><article class="pg-card h-100"><div class="pg-product-visual visual-green"><span>Last pieces</span></div><div class="pg-product-body"><div class="pg-product-brand">PoshakGhor Select</div><h3 class="pg-product-title">Weekend linen set</h3><div class="d-flex justify-content-between align-items-center gap-2"><span class="pg-product-price">৳ 3,200</span><span class="pg-stock out">Sold out</span></div><button class="btn btn-primary w-100 mt-3" disabled>Notify me</button></div></article></div>
            </div>
            <p class="small text-muted mt-3 mb-0" data-search-feedback aria-live="polite"></p>
        </section>

        <section class="pg-showcase-section" id="forms">
            <span class="pg-eyebrow">04 / Inputs</span><h2 class="pg-showcase-heading">Forms, validation & search</h2>
            <div class="row g-4">
                <div class="col-lg-6"><form data-demo-validation class="needs-validation" novalidate><div class="row g-3"><div class="col-md-6"><label class="form-label" for="demoName">Full name</label><input id="demoName" class="form-control" placeholder="e.g. Samira Rahman" required /><div class="invalid-feedback">Please enter your name.</div></div><div class="col-md-6"><label class="form-label" for="demoEmail">Email address</label><input id="demoEmail" class="form-control" type="email" placeholder="name@example.com" required /><div class="invalid-feedback">Enter a valid email address.</div></div><div class="col-12"><label class="form-label" for="demoCollection">Preferred collection</label><select id="demoCollection" class="form-select"><option>New season essentials</option><option>Clearance finds</option></select></div><div class="col-12"><div class="form-check"><input class="form-check-input" type="checkbox" id="demoUpdates" /><label class="form-check-label small" for="demoUpdates">Send me thoughtful updates, not noise.</label></div></div><div class="col-12"><button class="btn btn-primary" type="submit">Validate form</button><input class="form-control mt-3" disabled value="Disabled field example" aria-label="Disabled field example" /></div></div></form></div>
                <div class="col-lg-6"><label class="form-label" for="catalogSearch">Search the edit</label><form class="pg-search" role="search" data-product-search><span aria-hidden="true">⌕</span><input id="catalogSearch" class="form-control" placeholder="Search brands, styles, collections" /><button class="btn btn-primary" type="submit">Search</button></form><div class="mt-4"><label class="form-label">Quantity selector</label><div class="d-flex align-items-center gap-3"><div class="pg-quantity"><button type="button" data-quantity-step="-1" aria-label="Decrease quantity">−</button><input value="2" min="1" max="20" aria-label="Quantity" /><button type="button" data-quantity-step="1" aria-label="Increase quantity">+</button></div><span class="small text-muted">A keyboard-accessible stepper pattern</span></div></div></div>
            </div>
        </section>

        <section class="pg-showcase-section" id="commerce">
            <span class="pg-eyebrow">05 / Commerce data</span><h2 class="pg-showcase-heading">Tables, badges & pagination</h2>
            <div class="d-flex flex-wrap gap-2 mb-3"><span class="pg-badge pg-badge-primary">Curated</span><span class="pg-badge pg-badge-success">Available</span><span class="pg-badge pg-badge-warning">Low stock</span><span class="pg-badge pg-badge-danger">Clearance</span><span class="pg-badge pg-badge-info">New collection</span></div>
            <div class="table-responsive rounded border"><table class="table pg-table table-hover mb-0"><thead><tr><th>Item</th><th>Offer</th><th>Availability</th><th class="text-end">Price</th></tr></thead><tbody><tr><td><strong>Everyday drape</strong><div class="small text-muted">Aarong Edit</div></td><td><span class="pg-badge pg-badge-primary">Member price</span></td><td><span class="pg-stock">In stock</span></td><td class="text-end">৳ 2,490</td></tr><tr><td><strong>Soft structure shirt</strong><div class="small text-muted">Studio Neel</div></td><td><span class="pg-badge pg-badge-danger">−35%</span></td><td><span class="pg-stock low">4 remaining</span></td><td class="text-end">৳ 1,690</td></tr></tbody></table></div>
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mt-3"><small class="text-muted">Showing 1–2 of 24 pieces</small><nav aria-label="Product pages"><ul class="pagination pagination-sm mb-0"><li class="page-item disabled"><span class="page-link">Previous</span></li><li class="page-item active" aria-current="page"><span class="page-link">1</span></li><li class="page-item"><a class="page-link" href="#commerce">2</a></li><li class="page-item"><a class="page-link" href="#commerce">3</a></li><li class="page-item"><a class="page-link" href="#commerce">Next</a></li></ul></nav></div>
        </section>

        <section class="pg-showcase-section" id="feedback">
            <span class="pg-eyebrow">06 / Feedback</span><h2 class="pg-showcase-heading">Alerts, modals & toasts</h2>
            <div class="alert alert-primary" role="status"><strong>Just for you.</strong> Your edit is ready — explore the pieces selected for this season.</div><div class="alert alert-success" role="status"><strong>Added to your bag.</strong> We'll keep your selection here while you browse.</div>
            <div class="d-flex flex-wrap gap-2"><button class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#fitModal">Open size guide modal</button><button class="btn btn-primary" data-demo-toast>Show toast</button></div>
            <div class="modal fade" id="fitModal" tabindex="-1" aria-labelledby="fitModalTitle" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h3 class="modal-title fs-5" id="fitModalTitle">A considered fit</h3><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body">A reusable Bootstrap modal inherits surface, border, type and action tokens in either theme.</div><div class="modal-footer"><button class="btn btn-outline-primary" data-bs-dismiss="modal">Continue browsing</button></div></div></div></div>
            <div class="toast-container position-fixed bottom-0 end-0 p-3 pg-toast-container"><div id="designSystemToast" class="toast" role="status" aria-live="polite" aria-atomic="true"><div class="toast-header"><span class="pg-theme-dot me-2" aria-hidden="true"></span><strong class="me-auto">PoshakGhor</strong><small>Just now</small><button type="button" class="btn-close ms-2" data-bs-dismiss="toast" aria-label="Close"></button></div><div class="toast-body">Your component preview is up to date.</div></div></div>
        </section>

        <section class="pg-showcase-section" id="navigation">
            <span class="pg-eyebrow">07 / Wayfinding</span><h2 class="pg-showcase-heading">Navigation & responsive patterns</h2>
            <div class="pg-hero mb-4"><div class="pg-hero-art" aria-hidden="true"></div><div class="pg-hero-copy"><span class="pg-eyebrow">A new season, thoughtfully chosen</span><h3 class="pg-display pg-hero-title">Find your next favourite.</h3><p class="pg-lead">Editorial layouts and clear commerce actions share the same responsive Bootstrap grid.</p><a href="#products" class="btn btn-primary">Explore the edit</a></div></div>
            <nav aria-label="Collection breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="#navigation">Collections</a></li><li class="breadcrumb-item"><a href="#navigation">Clothing</a></li><li class="breadcrumb-item active" aria-current="page">New arrivals</li></ol></nav>
            <div class="small text-muted mt-3">Resize the viewport: cards move from two columns on small screens to three on large screens; the section navigation remains horizontally scrollable.</div>
        </section>

        <section class="pg-showcase-section" id="states">
            <span class="pg-eyebrow">08 / System states</span><h2 class="pg-showcase-heading">Loading & empty states</h2>
            <div class="row g-3"><div class="col-md-6"><div class="pg-loading-state" role="status"><span class="pg-spinner" aria-hidden="true"></span><span class="small mt-3">Finding pieces for you…</span><span class="visually-hidden">Loading products</span></div></div><div class="col-md-6"><div class="pg-empty-state"><span class="pg-empty-icon" aria-hidden="true">♡</span><strong class="mt-2">Your saved edit is waiting</strong><span class="small mt-1">Save pieces you love and find them here.</span><button class="btn btn-outline-primary btn-sm mt-3">Explore new arrivals</button></div></div></div>
            <div class="pg-skeleton-row mt-4" aria-hidden="true"><div class="pg-skeleton skeleton-wide"></div><div class="pg-skeleton skeleton-short"></div><div class="pg-skeleton skeleton-medium"></div><span class="visually-hidden">Content loading</span></div>
        </section>
        <footer class="pt-4 small text-muted">PoshakGhor Design System · Bootstrap 5 · app-owned component layer</footer>
    </div>
</div>

