@{
    ViewData["Title"] = "Dashboard";
}

<section class="mb-4">
    <span class="ay-uppercase text-body-secondary">POSHAKGHOR · MERCHANT STUDIO</span>
    <h1 class="mt-2 mb-2">Dashboard</h1>
    <p class="text-body-secondary mb-0">A clean overview of your store. Marketplace data and workflows will connect here as features are added.</p>
</section>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <article class="card h-100">
            <div class="card-body">
                <p class="text-body-secondary small mb-1">PRODUCTS</p>
                <p class="display-6 mb-0">0</p>
                <p class="text-body-secondary small mb-0">Catalog items in your store</p>
            </div>
        </article>
    </div>
    <div class="col-sm-6 col-xl-3">
        <article class="card h-100">
            <div class="card-body">
                <p class="text-body-secondary small mb-1">ORDERS</p>
                <p class="display-6 mb-0">0</p>
                <p class="text-body-secondary small mb-0">Orders awaiting fulfilment</p>
            </div>
        </article>
    </div>
    <div class="col-sm-6 col-xl-3">
        <article class="card h-100">
            <div class="card-body">
                <p class="text-body-secondary small mb-1">CUSTOMERS</p>
                <p class="display-6 mb-0">0</p>
                <p class="text-body-secondary small mb-0">Registered shoppers</p>
            </div>
        </article>
    </div>
    <div class="col-sm-6 col-xl-3">
        <article class="card h-100">
            <div class="card-body">
                <p class="text-body-secondary small mb-1">REVENUE</p>
                <p class="display-6 mb-0">৳ 0</p>
                <p class="text-body-secondary small mb-0">Gross sales to date</p>
            </div>
        </article>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <article class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <strong>Getting started</strong>
                <span class="badge text-bg-secondary">Setup</span>
            </div>
            <div class="card-body">
                <p class="text-body-secondary mb-3">Connect your catalog, orders, and customers to bring this marketplace to life.</p>
                <div class="d-flex flex-wrap gap-2">
                    <a class="btn btn-primary" href="/components">Component reference</a>
                    <a class="btn btn-outline-secondary" href="/shop">Refresh dashboard</a>
                </div>
            </div>
        </article>
    </div>
    <div class="col-lg-5">
        <article class="card h-100">
            <div class="card-header"><strong>Quick links</strong></div>
            <div class="card-body d-flex flex-column gap-2">
                <a class="btn btn--ghost text-start" href="/">Customer storefront</a>
                <a class="btn btn--ghost text-start" href="/login">Sign in</a>
                <a class="btn btn--ghost text-start" href="/register">Create account</a>
            </div>
        </article>
    </div>
</div>
