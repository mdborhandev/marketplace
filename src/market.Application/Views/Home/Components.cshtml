@{
    ViewData["Title"] = "Component Library";
}

<div class="container-fluid px-0 pb-5">
    <header class="d-flex flex-column flex-md-row align-items-md-end justify-content-between gap-4 mb-5">
        <div>
            <span class="text-uppercase small fw-semibold text-primary">DEVELOPER REFERENCE</span>
            <h1 class="display-5 mb-2">Component library</h1>
            <p class="lead text-body-secondary mb-0">A live preview of the Bootstrap components and theme styles used across the marketplace.</p>
        </div>
        <a class="btn btn-outline-secondary" href="/shop">Back to shop</a>
    </header>

    <section class="mb-5" aria-labelledby="type-title">
        <div class="d-flex align-items-baseline gap-3 mb-3"><span class="font-monospace text-primary small">01</span><h2 class="h4 mb-0" id="type-title">Typography and colors</h2></div>
        <div class="card"><div class="card-body">
            <p class="text-uppercase small text-body-secondary mb-2">Eyebrow text</p>
            <h1>Heading one <small class="text-body-secondary">Supporting text</small></h1>
            <h2>Heading two</h2><h3>Heading three</h3>
            <p class="mb-3">Body copy for product details, merchant notes, and general page content. <a href="#buttons">Text link</a> uses the active theme color.</p>
            <div class="d-flex flex-wrap gap-2"><span class="text-body-secondary">Secondary text</span><span class="text-success">Success</span><span class="text-warning">Warning</span><span class="text-danger">Error</span><span class="text-primary">Primary</span></div>
        </div></div>
    </section>

    <section class="mb-5" id="buttons" aria-labelledby="buttons-title">
        <div class="d-flex align-items-baseline gap-3 mb-3"><span class="font-monospace text-primary small">02</span><h2 class="h4 mb-0" id="buttons-title">Buttons and actions</h2></div>
        <div class="card"><div class="card-body d-flex flex-wrap align-items-center gap-2">
            <button class="btn btn-primary" type="button">Primary action</button>
            <button class="btn btn-secondary" type="button">Secondary</button>
            <button class="btn btn-outline-primary" type="button">Outline</button>
            <button class="btn btn-outline-secondary" type="button">Quiet action</button>
            <button class="btn btn-success" type="button">Confirm</button>
            <button class="btn btn-danger" type="button">Remove</button>
            <button class="btn btn-primary" type="button" disabled>Disabled</button>
            <div class="btn-group" role="group" aria-label="View selection"><button class="btn btn-outline-secondary active" type="button">Grid</button><button class="btn btn-outline-secondary" type="button">List</button></div>
        </div></div>
    </section>

    <section class="mb-5" aria-labelledby="cards-title">
        <div class="d-flex align-items-baseline gap-3 mb-3"><span class="font-monospace text-primary small">03</span><h2 class="h4 mb-0" id="cards-title">Cards and surfaces</h2></div>
        <div class="row g-3">
            <div class="col-md-6"><article class="card h-100"><div class="card-header d-flex justify-content-between align-items-center"><strong>Collection summary</strong><span class="badge text-bg-success">Live</span></div><div class="card-body"><h3 class="h5 card-title">Autumn essentials</h3><p class="card-text text-body-secondary">A flexible surface for product, inventory, and merchant information.</p><a class="btn btn-primary btn-sm" href="#forms">Edit collection</a></div><div class="card-footer text-body-secondary small">Updated just now</div></article></div>
            <div class="col-md-6"><article class="card h-100"><div class="card-body"><div class="d-flex justify-content-between align-items-start"><div><p class="text-body-secondary small mb-1">NET SALES</p><p class="display-6 mb-0">৳ 184,290</p></div><span class="badge text-bg-success">+12.8%</span></div><div class="progress mt-4" role="progressbar" aria-label="Monthly sales target" aria-valuenow="72" aria-valuemin="0" aria-valuemax="100"><div class="progress-bar" style="width:72%">72%</div></div></div></article></div>
        </div>
    </section>

    <section class="mb-5" aria-labelledby="feedback-title">
        <div class="d-flex align-items-baseline gap-3 mb-3"><span class="font-monospace text-primary small">04</span><h2 class="h4 mb-0" id="feedback-title">Badges and alerts</h2></div>
        <div class="card"><div class="card-body">
            <div class="d-flex flex-wrap gap-2 mb-4"><span class="badge text-bg-primary">New</span><span class="badge text-bg-secondary">Draft</span><span class="badge text-bg-success">In stock</span><span class="badge text-bg-warning">Low stock</span><span class="badge text-bg-danger">Out of stock</span><span class="badge rounded-pill text-bg-info">Featured</span></div>
            <div class="alert alert-success" role="status"><strong>Saved.</strong> Your collection changes are ready to publish.</div>
            <div class="alert alert-warning mb-0" role="alert"><strong>Stock is running low.</strong> Review the remaining sizes before your next campaign.</div>
        </div></div>
    </section>

    <section class="mb-5" id="forms" aria-labelledby="forms-title">
        <div class="d-flex align-items-baseline gap-3 mb-3"><span class="font-monospace text-primary small">05</span><h2 class="h4 mb-0" id="forms-title">Forms and validation</h2></div>
        <div class="card"><div class="card-body">
            <div class="row g-3">
                <div class="col-md-6"><label class="form-label" for="sample-name">Store name</label><input class="form-control" id="sample-name" placeholder="e.g. PoshakGhor Studio" /><div class="form-text">Shown to customers in your storefront.</div></div>
                <div class="col-md-6"><label class="form-label" for="sample-category">Category</label><select class="form-select" id="sample-category"><option selected>Select a category</option><option>Clothing</option><option>Accessories</option><option>Home</option></select></div>
                <div class="col-md-6"><label class="form-label" for="sample-email">Contact email</label><input class="form-control is-valid" id="sample-email" type="email" value="hello@poshakghor.com" /><div class="valid-feedback">Looks good.</div></div>
                <div class="col-md-6"><label class="form-label" for="sample-code">Discount code</label><input class="form-control is-invalid" id="sample-code" value="WELCOME" /><div class="invalid-feedback">Use at least 8 characters.</div></div>
                <div class="col-12"><label class="form-label" for="sample-description">Description</label><textarea class="form-control" id="sample-description" rows="3" placeholder="Add a short description"></textarea></div>
                <div class="col-12 d-flex flex-wrap align-items-center gap-3"><div class="form-check"><input class="form-check-input" id="sample-active" type="checkbox" checked /><label class="form-check-label" for="sample-active">Active collection</label></div><div class="form-check form-switch"><input class="form-check-input" id="sample-featured" type="checkbox" role="switch" /><label class="form-check-label" for="sample-featured">Feature this collection</label></div><button class="btn btn-primary ms-md-auto" type="button">Save preview</button></div>
            </div>
        </div></div>
    </section>

    <section class="mb-5" aria-labelledby="table-title">
        <div class="d-flex align-items-baseline gap-3 mb-3"><span class="font-monospace text-primary small">06</span><h2 class="h4 mb-0" id="table-title">Tables and pagination</h2></div>
        <div class="card"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th scope="col">Product</th><th scope="col">SKU</th><th scope="col">Inventory</th><th scope="col">Price</th><th scope="col">Status</th></tr></thead><tbody><tr><td><strong>Everyday linen shirt</strong><div class="small text-body-secondary">Clothing · 4 variants</div></td><td>PG-LN-042</td><td>128</td><td>৳ 2,490</td><td><span class="badge text-bg-success">Available</span></td></tr><tr><td><strong>Soft leather tote</strong><div class="small text-body-secondary">Accessories · 2 variants</div></td><td>PG-AC-018</td><td>6</td><td>৳ 4,800</td><td><span class="badge text-bg-warning">Low stock</span></td></tr><tr><td><strong>Classic cotton scarf</strong><div class="small text-body-secondary">Accessories · 3 variants</div></td><td>PG-AC-031</td><td>0</td><td>৳ 1,250</td><td><span class="badge text-bg-secondary">Sold out</span></td></tr></tbody></table></div><div class="card-body d-flex justify-content-between align-items-center gap-3 flex-wrap"><span class="small text-body-secondary">Showing 1–3 of 24 products</span><nav aria-label="Product table pages"><ul class="pagination pagination-sm mb-0"><li class="page-item disabled"><span class="page-link">Previous</span></li><li class="page-item active" aria-current="page"><span class="page-link">1</span></li><li class="page-item"><a class="page-link" href="#table-title">2</a></li><li class="page-item"><a class="page-link" href="#table-title">Next</a></li></ul></nav></div></div>
    </section>

    <section class="mb-5" aria-labelledby="navigation-title">
        <div class="d-flex align-items-baseline gap-3 mb-3"><span class="font-monospace text-primary small">07</span><h2 class="h4 mb-0" id="navigation-title">Tabs and accordion</h2></div>
        <div class="row g-3">
            <div class="col-lg-6"><div class="card h-100"><div class="card-body"><ul class="nav nav-tabs" id="sample-tabs" role="tablist"><li class="nav-item" role="presentation"><button class="nav-link active" id="overview-tab" data-bs-toggle="tab" data-bs-target="#overview-pane" type="button" role="tab" aria-controls="overview-pane" aria-selected="true">Overview</button></li><li class="nav-item" role="presentation"><button class="nav-link" id="details-tab" data-bs-toggle="tab" data-bs-target="#details-pane" type="button" role="tab" aria-controls="details-pane" aria-selected="false">Details</button></li></ul><div class="tab-content pt-3"><div class="tab-pane fade show active" id="overview-pane" role="tabpanel" aria-labelledby="overview-tab" tabindex="0">Keep related information organized with accessible tab navigation.</div><div class="tab-pane fade" id="details-pane" role="tabpanel" aria-labelledby="details-tab" tabindex="0">The tab component is powered by the local Bootstrap JavaScript bundle.</div></div></div></div></div>
            <div class="col-lg-6"><div class="accordion" id="sample-accordion"><div class="accordion-item"><h3 class="accordion-header"><button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#accordion-one" aria-expanded="true" aria-controls="accordion-one">Product details</button></h3><div id="accordion-one" class="accordion-collapse collapse show" data-bs-parent="#sample-accordion"><div class="accordion-body">Use accordions to keep longer product and order details compact.</div></div></div><div class="accordion-item"><h3 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#accordion-two" aria-expanded="false" aria-controls="accordion-two">Shipping information</button></h3><div id="accordion-two" class="accordion-collapse collapse" data-bs-parent="#sample-accordion"><div class="accordion-body">Shipping content can be expanded when the merchant needs it.</div></div></div></div></div>
        </div>
    </section>

    <section class="mb-5" aria-labelledby="overlays-title">
        <div class="d-flex align-items-baseline gap-3 mb-3"><span class="font-monospace text-primary small">08</span><h2 class="h4 mb-0" id="overlays-title">Dropdowns, modal, and toast</h2></div>
        <div class="card"><div class="card-body d-flex flex-wrap align-items-center gap-3">
            <div class="dropdown"><button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">More actions</button><ul class="dropdown-menu"><li><a class="dropdown-item" href="#overlays-title">Edit details</a></li><li><a class="dropdown-item" href="#overlays-title">Duplicate item</a></li><li><hr class="dropdown-divider" /></li><li><a class="dropdown-item text-danger" href="#overlays-title">Archive</a></li></ul></div>
            <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#sample-modal">Open modal</button>
            <button class="btn btn-outline-primary" id="show-sample-toast" type="button">Show toast</button>
            <div class="modal fade" id="sample-modal" tabindex="-1" aria-labelledby="sample-modal-title" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5" id="sample-modal-title">Publish collection?</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body">This is a preview of a confirmation modal for a merchant action.</div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-primary" data-bs-dismiss="modal">Confirm</button></div></div></div></div>
            <div class="toast-container position-fixed bottom-0 end-0 p-3"><div id="sample-toast" class="toast" role="status" aria-live="polite" aria-atomic="true"><div class="toast-header"><strong class="me-auto">PoshakGhor</strong><small>Just now</small><button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button></div><div class="toast-body">Your preview is up to date.</div></div></div>
        </div></div>
    </section>
</div>

@section Scripts {
    <script>
        document.getElementById('show-sample-toast')?.addEventListener('click', () => {
            bootstrap.Toast.getOrCreateInstance(document.getElementById('sample-toast')).show();
        });
    </script>
}
