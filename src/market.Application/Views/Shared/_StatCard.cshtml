@model (string Label, string Value, string Change, string ChangeClass)

<article class="card h-100">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-start">
            <div>
                <p class="text-body-secondary small mb-1">@Model.Label</p>
                <p class="display-6 mb-0">@Model.Value</p>
            </div>
            <span class="badge @Model.ChangeClass">@Model.Change</span>
        </div>
    </div>
</article>