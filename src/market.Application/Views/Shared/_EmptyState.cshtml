@model (string Title, string Description, string ActionText, string ActionUrl)

<div class="card border-0 shadow-sm">
    <div class="card-body text-center py-5">
        <h3 class="h5 mb-2">@Model.Title</h3>
        <p class="text-body-secondary mb-3">@Model.Description</p>
        @if (!string.IsNullOrWhiteSpace(Model.ActionUrl))
        {
            <a class="btn btn-primary" href="@Model.ActionUrl">@Model.ActionText</a>
        }
    </div>
</div>