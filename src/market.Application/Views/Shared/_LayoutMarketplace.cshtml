<!doctype html>
<html lang="en" class="layout-compact" dir="ltr" data-skin="default" data-bs-theme="dark" data-assets-path="@Url.Content("~/marketplaceTheme/assets/")" data-template="marketplace">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Marketplace</title>
    <link rel="preconnect" href="https://use.hugeicons.com" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://use.hugeicons.com/font/icons.css" />
    <link id="core-theme" rel="stylesheet" href="~/marketplaceTheme/assets/vendor/css/core-dark.css" />
    <link id="component-theme" rel="stylesheet" href="~/marketplaceTheme/assets/vendor/css/theme-default-dark.css" />
    <link rel="stylesheet" href="~/marketplaceTheme/assets/css/demo.css" />
    <link rel="stylesheet" href="~/marketplaceTheme/assets/vendor/libs/pickr/pickr-themes.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <script src="~/marketplaceTheme/assets/vendor/js/helpers.js"></script>
    <script src="~/marketplaceTheme/assets/vendor/libs/pickr/pickr.js"></script>
    <script src="~/marketplaceTheme/assets/vendor/js/template-customizer.js"></script>
    <script src="~/marketplaceTheme/assets/js/config.js"></script>
    <script>
        (() => {
            const root = document.documentElement;
            const coreTheme = document.getElementById('core-theme');
            const componentTheme = document.getElementById('component-theme');
            const updateThemeStyles = () => {
                const dark = root.getAttribute('data-bs-theme') === 'dark';
                coreTheme.href = `@Url.Content("~/marketplaceTheme/assets/vendor/css/")${dark ? 'core-dark.css' : 'core.css'}`;
                componentTheme.href = `@Url.Content("~/marketplaceTheme/assets/vendor/css/")${dark ? 'theme-default-dark.css' : 'theme-default.css'}`;
            };
            new MutationObserver(updateThemeStyles).observe(root, { attributes: true, attributeFilter: ['data-bs-theme'] });
            updateThemeStyles();
        })();
    </script>
</head>
<body>
    <div class="layout-wrapper layout-content-navbar layout-without-menu">
        <div class="layout-container">
            <div class="layout-page">
                <nav class="layout-navbar container-xxl navbar-detached navbar navbar-expand-xl align-items-center bg-navbar-theme" id="layout-navbar">
                    <div class="navbar-nav-right d-flex align-items-center w-100">
                        <a asp-area="" asp-controller="Home" asp-action="Index" class="navbar-brand fw-semibold mb-0">Marketplace</a>
                        <button type="button" class="btn btn-icon btn-text-secondary rounded-pill ms-auto" id="theme-toggle" aria-label="Switch to light mode" title="Switch theme">
                            <i class="hgi hgi-stroke hgi-rounded hgi-sun-03" id="theme-toggle-icon" aria-hidden="true"></i>
                        </button>
                    </div>
                </nav>

                <div class="content-wrapper">
                    <main class="container-xxl flex-grow-1 container-p-y" role="main">
                        @RenderBody()
                    </main>
                    <footer class="content-footer footer bg-footer-theme"></footer>
                    <div class="content-backdrop fade"></div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (() => {
            const button = document.getElementById('theme-toggle');
            const icon = document.getElementById('theme-toggle-icon');
            const updateButton = () => {
                const dark = document.documentElement.getAttribute('data-bs-theme') === 'dark';
                const nextMode = dark ? 'light' : 'dark';
                button.setAttribute('aria-label', `Switch to ${nextMode} mode`);
                button.title = `Switch to ${nextMode} mode`;
                icon.classList.toggle('hgi-sun-03', dark);
                icon.classList.toggle('hgi-moon-02', !dark);
            };
            button.addEventListener('click', () => {
                const nextMode = document.documentElement.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark';
                window.Helpers.setStoredTheme('marketplace', nextMode);
                window.Helpers.setTheme(nextMode);
                updateButton();
            });
            updateButton();
        })();
    </script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
