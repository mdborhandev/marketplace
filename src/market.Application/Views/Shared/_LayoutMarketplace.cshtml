<!doctype html>
<html lang="en" class="layout-menu-fixed layout-compact" dir="ltr" data-skin="default" data-bs-theme="dark" data-assets-path="@Url.Content("~/marketplaceTheme/assets/")" data-template="marketplace">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Marketplace</title>
    <link rel="preconnect" href="https://use.hugeicons.com" crossorigin="anonymous" />
    <link rel="stylesheet" href="https://use.hugeicons.com/font/icons.css" />
    <link id="core-theme" rel="stylesheet" href="~/marketplaceTheme/assets/vendor/css/core-dark.css" />
    <link id="component-theme" rel="stylesheet" href="~/marketplaceTheme/assets/vendor/css/theme-default-dark.css" />
    <link rel="stylesheet" href="~/marketplaceTheme/assets/css/demo.css" />
    <link rel="stylesheet" href="~/marketplaceTheme/assets/vendor/libs/pickr/pickr-themes.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <script src="~/marketplaceTheme/assets/vendor/js/helpers.js"></script>
    <script src="~/marketplaceTheme/assets/vendor/libs/pickr/pickr.js"></script>
    <script src="~/marketplaceTheme/assets/vendor/js/template-customizer.js"></script>
    <script src="~/marketplaceTheme/assets/js/config.js"></script>
    <script>
        (() => {
            const root = document.documentElement;
            const coreTheme = document.getElementById('core-theme');
            const componentTheme = document.getElementById('component-theme');
            const updateThemeStyles = () => {
                const dark = root.getAttribute('data-bs-theme') === 'dark';
                coreTheme.href = `@Url.Content("~/marketplaceTheme/assets/vendor/css/")${dark ? 'core-dark.css' : 'core.css'}`;
                componentTheme.href = `@Url.Content("~/marketplaceTheme/assets/vendor/css/")${dark ? 'theme-default-dark.css' : 'theme-default.css'}`;
            };
            new MutationObserver(updateThemeStyles).observe(root, { attributes: true, attributeFilter: ['data-bs-theme'] });
            updateThemeStyles();
        })();
    </script>
</head>
<body>
    <div class="layout-wrapper layout-content-navbar">
        <div class="layout-container">
            <aside id="layout-menu" class="layout-menu menu-vertical menu">
                <div class="app-brand demo">
                    <a asp-area="" asp-controller="Home" asp-action="Index" class="app-brand-link">
                        <span class="app-brand-logo demo"><i class="hgi hgi-stroke hgi-rounded hgi-store-01"></i></span>
                        <span class="app-brand-text demo menu-text fw-bold ms-2">Marketplace</span>
                    </a>
                    <a href="javascript:void(0);" class="layout-menu-toggle menu-link text-large ms-auto" aria-label="Collapse navigation">
                        <i class="hgi hgi-stroke hgi-rounded hgi-arrow-left-01 d-flex align-items-center justify-content-center"></i>
                    </a>
                </div>
                <div class="menu-inner-shadow"></div>
                <ul class="menu-inner py-1">
                    <li class="menu-item active">
                        <a asp-area="" asp-controller="Home" asp-action="Index" class="menu-link">
                            <i class="menu-icon tf-icons hgi hgi-stroke hgi-rounded hgi-home-01"></i>
                            <div class="text-truncate">Home</div>
                        </a>
                    </li>
                </ul>
            </aside>

            <div class="layout-page">
                <nav class="layout-navbar container-xxl navbar-detached navbar navbar-expand-xl align-items-center bg-navbar-theme" id="layout-navbar">
                    <div class="layout-menu-toggle navbar-nav align-items-xl-center me-4 me-xl-0 d-xl-none">
                        <a class="nav-item nav-link px-0 me-xl-6" href="javascript:void(0);" aria-label="Open navigation">
                            <i class="hgi hgi-stroke hgi-rounded hgi-menu-01"></i>
                        </a>
                    </div>
                    <div class="navbar-nav-right d-flex align-items-center">
                        <span class="fw-semibold">Marketplace</span>
                    </div>
                </nav>

                <div class="content-wrapper">
                    <main class="container-xxl flex-grow-1 container-p-y" role="main">
                        @RenderBody()
                    </main>
                    <footer class="content-footer footer bg-footer-theme"></footer>
                    <div class="content-backdrop fade"></div>
                </div>
            </div>
        </div>
        <div class="layout-overlay layout-menu-toggle"></div>
    </div>

    <script src="~/marketplaceTheme/assets/vendor/js/menu.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/marketplaceTheme/assets/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
    <script src="~/marketplaceTheme/assets/js/main.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
