@model (string Eyebrow, string Title, string Description, string BackUrl, string BackText)

<header class="d-flex flex-column flex-md-row align-items-md-end justify-content-between gap-4 mb-5">
    <div>
        <span class="text-uppercase small fw-semibold text-primary">@Model.Eyebrow</span>
        <h1 class="display-5 mb-2">@Model.Title</h1>
        <p class="lead text-body-secondary mb-0">@Model.Description</p>
    </div>
    <a class="btn btn-outline-secondary" href="@Model.BackUrl">@Model.BackText</a>
</header>