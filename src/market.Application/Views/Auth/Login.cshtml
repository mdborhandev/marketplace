@model market.Application.ViewModels.Auth.LoginViewModel
@{
    ViewData["Title"] = "Sign in";
    Layout = "_LayoutAuth";
}

<section class="auth-card" aria-labelledby="login-title">
    <span class="auth-kicker">YOUR STORE, IN GOOD HANDS</span>
    <h2 id="login-title">Welcome back</h2>
    <p class="auth-intro">Sign in to continue to your merchant studio.</p>

    <form asp-action="Login" asp-controller="Auth" method="post" autocomplete="on">
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label class="form-label" for="login-email">Email address</label>
            <input class="form-control" id="login-email" asp-for="Email" type="email" autocomplete="username" placeholder="you@yourstore.com" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <div class="d-flex justify-content-between align-items-center">
                <label class="form-label" for="login-password">Password</label>
                <a class="auth-inline-link" href="/forgot-password">Forgot password?</a>
            </div>
            <input class="form-control" id="login-password" asp-for="Password" type="password" autocomplete="current-password" placeholder="Enter your password" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        <div class="form-check mb-4">
            <input class="form-check-input" id="remember-me" asp-for="RememberMe" />
            <label class="form-check-label" for="remember-me">Keep me signed in</label>
        </div>
        <button class="btn btn-primary auth-submit w-100" type="submit">Sign in</button>
    </form>

    <p class="auth-switch">New to PoshakGhor? <a href="/register">Create an account</a></p>
</section>