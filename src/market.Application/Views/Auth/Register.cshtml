@model market.Application.ViewModels.Auth.RegisterViewModel
@{
    ViewData["Title"] = "Create account";
    Layout = "_LayoutAuth";
}

<section class="auth-card auth-card-register" aria-labelledby="register-title">
    <span class="auth-kicker">A BETTER WAY TO SELL</span>
    <h2 id="register-title">Create your account</h2>
    <p class="auth-intro">Set up your merchant access to get started.</p>

    <form asp-action="Register" asp-controller="Auth" method="post" autocomplete="on">
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label class="form-label" for="register-name">Your name</label>
            <input class="form-control" id="register-name" asp-for="FullName" autocomplete="name" placeholder="Full name" />
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label" for="register-store">Store name</label>
            <input class="form-control" id="register-store" asp-for="StoreName" autocomplete="organization" placeholder="Your boutique or brand" />
            <span asp-validation-for="StoreName" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label" for="register-email">Email address</label>
            <input class="form-control" id="register-email" asp-for="Email" type="email" autocomplete="email" placeholder="you@yourstore.com" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label" for="register-role">Account type</label>
            <select class="form-select" id="register-role" asp-for="Role">
                <option value="Customer">Customer</option>
                <option value="Vendor">Vendor</option>
            </select>
            <span asp-validation-for="Role" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label" for="register-password">Create password</label>
            <input class="form-control" id="register-password" asp-for="Password" type="password" autocomplete="new-password" placeholder="At least 8 characters" />
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label" for="register-confirm-password">Confirm password</label>
            <input class="form-control" id="register-confirm-password" asp-for="ConfirmPassword" type="password" autocomplete="new-password" placeholder="Repeat password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>
        <div class="form-check mb-4">
            <input class="form-check-input" id="accept-terms" asp-for="AcceptTerms" />
            <label class="form-check-label" for="accept-terms">I accept the terms and conditions</label>
            <span asp-validation-for="AcceptTerms" class="text-danger"></span>
        </div>
        <button class="btn btn-primary auth-submit w-100" type="submit">Create account</button>
    </form>

    <p class="auth-switch">Already have an account? <a href="/login">Sign in</a></p>
</section>