@model market.Application.ViewModels.Auth.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot password";
}

<section class="auth-card" aria-labelledby="forgot-title">
    <span class="auth-kicker">ACCOUNT RECOVERY</span>
    <h2 id="forgot-title">Forgot password</h2>
    <p class="auth-intro">Enter your email and we will send a reset link.</p>

    <form asp-action="ForgotPassword" asp-controller="Auth" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="mb-3">
            <label class="form-label" for="forgot-email">Email address</label>
            <input class="form-control" id="forgot-email" asp-for="Email" type="email" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
        <button class="btn btn-primary auth-submit w-100" type="submit">Send reset link</button>
    </form>

    <p class="auth-switch"><a href="/login">Back to sign in</a></p>
</section>