@model market.Application.ViewModels.Auth.ResetPasswordViewModel
@{
    ViewData["Title"] = "Reset password";
}

<section class="auth-card" aria-labelledby="reset-title">
    <span class="auth-kicker">ACCOUNT RECOVERY</span>
    <h2 id="reset-title">Reset password</h2>
    <p class="auth-intro">Choose a new password for your account.</p>

    <form asp-action="ResetPassword" asp-controller="Auth" method="post">
        <input type="hidden" asp-for="Email" />
        <input type="hidden" asp-for="Token" />
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label class="form-label" for="reset-new-password">New password</label>
            <input class="form-control" id="reset-new-password" asp-for="NewPassword" type="password" />
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label class="form-label" for="reset-confirm-password">Confirm password</label>
            <input class="form-control" id="reset-confirm-password" asp-for="ConfirmPassword" type="password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>
        <button class="btn btn-primary auth-submit w-100" type="submit">Reset password</button>
    </form>
</section>