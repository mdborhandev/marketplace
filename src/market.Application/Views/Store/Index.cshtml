@{
    ViewData["Title"] = "PoshakGhor";
    Layout = "_LayoutStorefront";
}

<section class="py-5">
    <div class="container">
        <div class="storefront-hero p-4 p-lg-5 mb-5">
            <div class="row align-items-center g-4">
                <div class="col-lg-7">
                    <span class="badge bg-light text-primary mb-3">CURATED FASHION MARKETPLACE</span>
                    <h1 class="display-4 fw-bold mb-3">Discover boutique fashion from independent vendors</h1>
                    <p class="lead mb-4 opacity-75">A demo storefront. Products and vendors will be loaded from the backend later.</p>
                    <div class="d-flex flex-wrap gap-2">
                        <a class="btn btn-light btn-lg" href="/store">Start shopping</a>
                        <a class="btn btn-outline-light btn-lg" href="/register">Become a vendor</a>
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="card bg-white text-dark shadow-lg">
                        <div class="card-body">
                            <h2 class="h5 mb-3">Featured collection</h2>
                            <p class="text-body-secondary mb-3">Handpicked styles for the season, curated from verified vendors.</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="badge text-bg-success">New arrivals</span>
                                <a class="btn btn-primary btn-sm" href="/store">Explore</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between align-items-end mb-4">
            <div>
                <h2 class="h3 mb-1">Featured products</h2>
                <p class="text-body-secondary mb-0">Demo data for layout preview.</p>
            </div>
            <a class="btn btn-outline-primary" href="/store">View all</a>
        </div>
        <div class="row g-4">
            @for (var i = 1; i <= 6; i++)
            {
                <div class="col-sm-6 col-lg-4">
                    <article class="card storefront-product-card h-100">
                        <div class="ratio ratio-4x3 bg-secondary-subtle storefront-product-image"></div>
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h3 class="h6 mb-0">Demo Product @i</h3>
                                @if (i % 2 == 0)
                                {
                                    <span class="badge text-bg-warning">Low stock</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-success">In stock</span>
                                }
                            </div>
                            <p class="text-body-secondary small mb-3">Vendor Studio @((i % 3) + 1)</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <strong class="fs-5">৳ @(1200 + (i * 350))</strong>
                                <button class="btn btn-primary btn-sm" type="button">Add to cart</button>
                            </div>
                        </div>
                    </article>
                </div>
            }
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <h2 class="h3 mb-4">Shop by category</h2>
        <div class="row g-3">
            @foreach (var category in new[] { "Clothing", "Accessories", "Footwear", "Jewelry" })
            {
                <div class="col-6 col-md-3">
                    <a class="card storefront-category-card text-decoration-none h-100" href="/store">
                        <div class="card-body text-center py-4">
                            <h3 class="h6 mb-0">@category</h3>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
</section>