    <script>
        document.addEventListener('DOMContentLoaded', function() {
          const chatAvatar = document.getElementById('chatAvatar'); // your Copilot button (keep in page)
          const chatContainer = document.getElementById('chatContainer');
          const closeChat = document.getElementById('closeChat');
          const messageInput = document.getElementById('messageInput');
          const sendMessage = document.getElementById('sendMessage');
          const chatMessages = document.getElementById('chatMessages');
          const typingIndicator = document.getElementById('typingIndicator');

          // Helper to show/hide typing indicator
          function showTyping(show = true) {
            if (!typingIndicator) return;
            typingIndicator.style.display = show ? 'flex' : 'none';
          }

          // Toggle chat open/close (Bootstrap-friendly)
          function toggleChat() {
            if (chatContainer.classList.contains('d-none')) {
              // --- OPEN CHAT ---
              chatContainer.classList.remove('d-none');

              // animate: set visible
              // ensure we trigger transition by reading offset then applying new styles
              requestAnimationFrame(() => {
                chatContainer.style.opacity = '1';
                chatContainer.style.transform = 'translateY(0) scale(1)';
              });

              if (messageInput) messageInput.focus();
            } else {
              // --- CLOSE CHAT ---
              // animate out
              chatContainer.style.opacity = '0';
              chatContainer.style.transform = 'translateY(1rem) scale(.95)';

              // after transition hide element so it doesn't capture pointer/tab
              const TRANS_MS = 300;
              setTimeout(() => {
                chatContainer.classList.add('d-none');
              }, TRANS_MS);

            }
          }

          // Handle clicks
          if (chatAvatar) chatAvatar.addEventListener('click', toggleChat);
          if (closeChat) closeChat.addEventListener('click', toggleChat);

          // Enable/disable send button based on input
          if (messageInput) {
            messageInput.addEventListener('input', function() {
              sendMessage.disabled = messageInput.value.trim() === '';
            });

            // Send message on Enter key (keydown is more reliable)
            messageInput.addEventListener('keydown', function(e) {
              if (e.key === 'Enter' && !sendMessage.disabled) {
                e.preventDefault();
                sendChatMessage();
              }
            });
          }

          if (sendMessage) sendMessage.addEventListener('click', sendChatMessage);

          // Send chat message
          async function sendChatMessage() {
            if (!messageInput) return;
            const message = messageInput.value.trim();
            if (message === '') return;

            // Add user message to chat
            addMessage(message, 'user');
            messageInput.value = '';
            sendMessage.disabled = true;

            // Show typing indicator
            showTyping(true);

            // Helper function to perform the API request
            const makeAjaxRequest = async () => {
              const encodedQuestion = encodeURIComponent(message);
              const apiUrl = `https://103.174.50.236:9000/ask?question=${encodedQuestion}`;

              try {
                const response = await fetch(apiUrl, {
                  method: 'GET',
                  headers: { 'Accept': 'application/json' },
                });

                // Debug log
                console.log('fetch response', response);

                if (!response.ok) {
                  console.error('Network response was not ok', response.status);
                  return null;
                }

                return await response.json();
              } catch (error) {
                console.error('Fetch error:', error);
                return null;
              }
            };

            try {
              // Minimum delay to simulate typing
              const minDelay = new Promise(resolve => setTimeout(resolve, 800));

              // Perform the API request
              const response = await makeAjaxRequest();

              // Wait for minimum typing delay
              await minDelay;

              // Determine bot response
              let botResponse;
              if (response && response.answer) {
                botResponse = response.answer;
              } else {
                // Fallback demo responses
                const fallbackResponses = [
                  "I understand your question. Let me look that up for you.",
                  "That's a great question! Based on my knowledge, I can help with that.",
                  "Thanks for your message. I'm processing your request now.",
                  "I've received your query and I'm working on a response.",
                  "Interesting question! Let me provide some information on that."
                ];
                botResponse = fallbackResponses[Math.floor(Math.random() * fallbackResponses.length)];

                // Optional additional random delay
                await new Promise(resolve => setTimeout(resolve, Math.random() * 800));
              }

              // Hide typing indicator and show bot message
              showTyping(false);
              addMessage(botResponse, 'bot');

            } catch (error) {
              console.error('Unexpected error:', error);

              // Fallback demo response
              const fallbackResponses = [
                "I understand your question. Let me look that up for you.",
                "That's a great question! Based on my knowledge, I can help with that.",
                "Thanks for your message. I'm processing your request now.",
                "I've received your query and I'm working on a response.",
                "Interesting question! Let me provide some information on that."
              ];
              const randomResponse = fallbackResponses[Math.floor(Math.random() * fallbackResponses.length)];

              // small random delay before showing fallback
              await new Promise(resolve => setTimeout(resolve, Math.random() * 800));

              showTyping(false);
              addMessage(randomResponse, 'bot');
            }

            // Scroll to bottom of chat
            chatMessages.scrollTop = chatMessages.scrollHeight;
            sendMessage.disabled = false;
          }

          // Add message to chat (Bootstrap-friendly: inline styles instead of Tailwind)
          function addMessage(text, sender) {
            const messageElement = document.createElement('div');

            // Common styles
            messageElement.style.maxWidth = '80%';
            messageElement.style.padding = '0.6rem 0.9rem';
            messageElement.style.borderRadius = '18px';
            messageElement.style.fontSize = '0.9rem';
            messageElement.style.wordBreak = 'break-word';
            messageElement.style.display = 'inline-block';

            // Alignment and color based on sender
            if (sender === 'user') {
              messageElement.style.alignSelf = 'flex-end';
              messageElement.style.background = '#16a34a'; // green-600
              messageElement.style.color = '#fff';
              // rounded-right-bottom smaller radius effect
              messageElement.style.borderBottomRightRadius = '6px';
              messageElement.style.borderBottomLeftRadius = '18px';
            } else {
              messageElement.style.alignSelf = 'flex-start';
              messageElement.style.background = '#e5e7eb'; // gray-200
              messageElement.style.color = '#111827';
              messageElement.style.borderBottomLeftRadius = '6px';
              messageElement.style.borderBottomRightRadius = '18px';
            }

            messageElement.textContent = text;
            // append and ensure container is a flex column so alignSelf works
            chatMessages.appendChild(messageElement);
            chatMessages.scrollTop = chatMessages.scrollHeight;
          }

          // Responsive resize: update inline width
          function handleResize() {
            if (!chatContainer) return;
            if (window.innerWidth < 480) {
              chatContainer.style.width = '90vw';
            } else {
              chatContainer.style.width = '400px';
            }
          }
          window.addEventListener('resize', handleResize);
          handleResize();

          // Ensure initial visual state matches inline CSS definitions
          (function initVisualState() {
            // If container is not hidden, ensure visible style applied
            if (!chatContainer.classList.contains('d-none')) {
              chatContainer.style.opacity = '1';
              chatContainer.style.transform = 'translateY(0) scale(1)';
            } else {
              chatContainer.style.opacity = '0';
              chatContainer.style.transform = 'translateY(1rem) scale(.95)';
            }
            // typingIndicator initial display respected by inline markup; ensure none
            showTyping(false);
          })();

        });
    </script>

    

</body>
</html>

<!-- Chat container (Bootstrap version) -->
<div id="chatContainer"
     class="position-fixed d-none"
     style="
       bottom: 1.5rem;
       right: 1.5rem;
       width: 400px;
       height: 80vh;
       border-radius: 1rem;
       box-shadow: 0 10px 30px rgba(2,6,23,0.2);
       display: flex;
       flex-direction: column;
       opacity: 0;
       transform: translateY(1rem) scale(.95);
       transition: all 0.3s ease-in-out;
       z-index: 40;
     ">
    <!-- Header -->
    <div class="d-flex align-items-center justify-content-between p-3"
         style="background-color:#22c55e; color:#fff; border-top-left-radius:1rem; border-top-right-radius:1rem;">
        <div class="d-flex align-items-center" style="gap:12px;">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="white" aria-hidden="true" focusable="false">
                <path d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 9h12v2H6V9zm8 5H6v-2h8v2zm4-6H6V6h12v2z" />
            </svg>
            <span class="h6 mb-0" style="font-weight:600;">Co-Pilot Assistant</span>
        </div>

        <button id="closeChat" type="button" class="btn btn-link p-0" style="color: #ffffff; font-size: 1.25rem; line-height:1; text-decoration:none;">
            ✕
        </button>
    </div>

    <!-- Messages -->
    <div id="chatMessages"
         class="flex-grow-1 p-3 overflow-auto d-flex flex-column"
         style="gap:12px;">
        <div style="max-width:80%; align-self:flex-start; background:#e5e7eb; color:#1f2937; padding:0.75rem 1rem; border-radius:1rem; border-bottom-left-radius:0.5rem;">
            Hello! How can I assist you today?
        </div>
    </div>

    <!-- Typing indicator -->
    <div id="typingIndicator"
         class="py-2 ps-3" style="color:#4b5563; display:none;">
        <div class="d-flex align-items-center">
            <div style="width:6px; height:6px; background:#6b7280; border-radius:50%; animation: bounce 1s infinite;"></div>
            <div style="width:6px; height:6px; background:#6b7280; border-radius:50%; animation: bounce 1s infinite 0.2s;"></div>
            <div style="width:6px; height:6px; background:#6b7280; border-radius:50%; animation: bounce 1s infinite 0.4s;"></div>
        </div>
    </div>

    <!-- Input area -->
    <div class="p-3 border-top bg-dynamic">
        <div class="d-flex align-items-center" style="gap:10px;">
            <input id="messageInput"
                   type="text"
                   placeholder="Type your message..."
                   class="form-control"
                   style="border-radius:50px;padding:0.6rem 1rem; font-size:0.9rem; outline: none; box-shadow:none;" />

            <button id="sendMessage"
                    class="btn"
                    disabled
                    style="width:48px; height:48px; background:#22c55e; color:#fff; border-radius:50%; display:flex; align-items:center; justify-content:center; border:none;">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="white" aria-hidden="true" focusable="false">
                    <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z" />
                </svg>
            </button>
        </div>
    </div>
</div>

