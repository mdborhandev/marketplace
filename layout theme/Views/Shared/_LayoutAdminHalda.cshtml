        //     Add the currency sign
        //     return currencySign + formattedValue;
        // }

        
        function resolveDecimalPlaces(rawDecimalPlace) {
            let places;
            if (rawDecimalPlace === null || rawDecimalPlace === undefined) {
                places = 2; // default
            } else {
                places = parseInt(rawDecimalPlace);
                if (isNaN(places)) {
                    places = 2;
                }
            }
            if (places === 5) {
                places = 0;
            }
            return places;
        }


                // Currency formatter function using values from cookies
        function formatCurrency(value) {
            // Handle null/undefined values
            if (value === null || value === undefined) {
                value = 0;
            }
            const places = resolveDecimalPlaces(decimalPlace);
            // Format the number with the specified decimal places
            const formattedValue = new Intl.NumberFormat('en-US', {
                minimumFractionDigits: places,
                maximumFractionDigits: places
            }).format(value);
            // Add the currency sign
            return currencySign + formattedValue;
        }


        // Function to set a cookie
        function setCookie(name, value, days) {
            const date = new Date();
            date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000)); // Expires in "days" days
            document.cookie = `${name}=${value}; expires=${date.toUTCString()}; path=/`;
        }

        // Function to switch view mode and set the cookie
             function switchView(viewMode) {
            // Update the viewMode cookie with the new mode
            document.cookie = `viewMode=${viewMode}; path=/`;

            if (viewMode === 'applicant') {
                // If switching to applicant, redirect to the Job Dashboard
                window.location.href = '/JobApplication/JobDashboard';
            } else if (viewMode === 'user') {

                window.location.href = '/Home/Index'; // Or any other route you want for the user mode
            }
        }


