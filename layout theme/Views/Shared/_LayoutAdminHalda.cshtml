    <script>
        // Theme icon switcher for hgi icons
        const themeIconMap = {
            'sun': 'hgi-sun-03',
            'moon': 'hgi-moon-02',
            'desktop': 'hgi-building-03'
        };
        function updateThemeIcon() {
            const themeIcon = document.querySelector('.theme-icon-active');
            if (!themeIcon) return;
            const currentTheme = document.documentElement.getAttribute('data-bs-theme') || 'dark';
            let iconClass = 'hgi-sun-03';
            if (currentTheme === 'dark') iconClass = 'hgi-moon-02';
            else if (currentTheme === 'system') iconClass = 'hgi-building-03';
            themeIcon.classList.remove('hgi-sun-03', 'hgi-moon-02', 'hgi-building-03');
            themeIcon.classList.add(iconClass);
        }
        document.querySelectorAll('[data-bs-theme-value]').forEach(btn => {
            btn.addEventListener('click', function() {
                setTimeout(updateThemeIcon, 50);
            });
        });
        const themeObserver = new MutationObserver(updateThemeIcon);
        themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ['data-bs-theme'] });
        updateThemeIcon();

                document.addEventListener("DOMContentLoaded", function () {
            const baseUrl = "https://gtrbd.net/chitraupdateapi/api/";
            const userId = getUserIdFromCookie();
            const selectedCompanyId = getSelectedCompanyFromCookie(); // Get the selected company from cookies

            if (!userId) {
                console.error("User ID not found in cookies.");
                alert("Unable to retrieve User ID. Please log in again.");
                return;
            }

            const apiEndpoint = `${baseUrl}UserCompany/GetCompanybyUserId/${userId}`;
            const companyDetailsEndpoint = `${baseUrl}Company/`; // Base URL for company details
            const companyDropdown = document.getElementById("companyDropdown");
            const loadingIndicator = document.getElementById("loadingIndicator");

            if (loadingIndicator) loadingIndicator.style.display = "block"; // Show loading

            fetch(apiEndpoint)
                .then(response => {
                    if (!response.ok) {
                        throw new Error("Failed to fetch company data.");
                    }
                    return response.json();
                })
                .then(data => {
                    if (loadingIndicator) loadingIndicator.style.display = "none"; // Hide loading

                    if (data && Array.isArray(data) && data.length > 0) {
                        companyDropdown.innerHTML = ""; // Clear existing dropdown items

                        const companyIds = data.map(company => company.companyId);

                        // Fetch company details for each company ID
                        Promise.all(
                            companyIds.map(companyId =>
                                fetch(`${companyDetailsEndpoint}${companyId}`).then(response => {
                                    if (!response.ok) {
                                        throw new Error(`Failed to fetch details for company ID: ${companyId}`);
                                    }
                                    return response.json();
                                })
                            )
                        )
                        .then(companies => {
                            companies.forEach(company => {
                                if (company && company.name && company.id) {

                                    const isSelected = company.id === selectedCompanyId; // Check if this is the selected company
                                    const listItem = document.createElement("li");

                                    listItem.innerHTML = `
                                        <p class="dropdown-item mb-0 ${isSelected ? 'active' : ''}" style="cursor:pointer;" onclick="refreshAndSwitchCompany('${company.id}')">
                                            <i class="hgi hgi-stroke hgi-rounded hgi-building-03 me-2"></i>${company.name}
                                        </p>`;
                                    companyDropdown.appendChild(listItem);
                                } else {
                                    console.warn("Skipping invalid company:", company);
                                }
                            });
                        })
                        .catch(error => {
                            console.error("Error fetching company details:", error);
                            companyDropdown.innerHTML = `
                                <li class="dropdown-item text-center text-danger">
                                    Failed to load company details
                                </li>`;
                        });
                    } else {
                        companyDropdown.innerHTML = `
                            <li class="dropdown-item text-center text-muted">
                                No companies available
                            </li>`;
                    }
                })
                .catch(error => {
                    console.error("Error fetching company data:", error);
                    companyDropdown.innerHTML = `
                        <li class="dropdown-item text-center text-danger">
                            Failed to load companies
                        </li>`;
                });
        });

        // Function to refresh company data and switch
        function refreshAndSwitchCompany(companyId) {

            if (!companyId) {
                alert("Invalid company selected. Please try again.");
                return;
            }

            const refreshCompanyUrl = `/Account/RefreshCompanyData?comid=${encodeURIComponent(companyId)}`; // Pass the companyId in the URL

            fetch(refreshCompanyUrl, {
                method: "POST",  // Still POST request, but we're passing data in the query string
                headers: {
                    "Content-Type": "application/json" // Content type is still JSON, even though data is in the URL
                }
            })
            .then(response => {
                if (response.ok) {
                    document.cookie = `selectedCompany=${companyId}; path=/`;  // Store in cookie
                    location.reload(); // Reload the page to apply changes
                } else {
                    throw new Error("Failed to refresh company data");
                }
            })
            .catch(error => {
                console.error("Error refreshing company data:", error);
                alert("Failed to switch companies. Please try again.");
            });
        }

        // Function to retrieve selected company from cookies
        function getSelectedCompanyFromCookie() {
            const cookies = document.cookie.split("; ");
            for (let cookie of cookies) {
                const [key, value] = cookie.split("=");
                if (key === "ComId") return decodeURIComponent(value);
            }
            return null;
        }



        // Function to retrieve CSRF token (if applicable)
        function getCsrfToken() {
            const metaTag = document.querySelector('meta[name="csrf-token"]');
            return metaTag ? metaTag.getAttribute("content") : null;
        }

        // Function to retrieve user ID from cookies
        function getUserIdFromCookie() {
            const cookies = document.cookie.split("; ");
            for (let cookie of cookies) {
                const [key, value] = cookie.split("=");
                if (key === "UserId") return decodeURIComponent(value);
            }
            return null;
        }

