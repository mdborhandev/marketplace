               function fetchProfileImage() {
            // Retrieve user ID from cookies
            const userId = getCookie('UserId');
            if (!userId) {
                return;
            }

            const url = `https://gtrbd.net/chitraupdateapi/api/UserCompany/GetProfileImage/${userId}`;

            fetch(url)
                .then(response => {
                    if (response.ok) {
                        return response.blob();
                    } else {
                        throw new Error("No profile image found.");
                    }
                })
                .then(blob => {
                    // Create an object URL for the image
                    const imageUrl = URL.createObjectURL(blob);

                    // Update both dropdown button and menu item
                    // Dropdown button image
                    document.getElementById("userProfileImageDropdown").src = imageUrl;
                    document.getElementById("userProfileImageDropdown").style.display = "inline";
                    document.getElementById("userIconDropdown").style.display = "none";

                    // Menu item image
                    document.getElementById("userProfileImageMenu").src = imageUrl;
                    document.getElementById("userProfileImageMenu").style.display = "inline";
                    document.getElementById("userIconMenu").style.display = "none";
                })
                .catch(error => {

                    // Hide images and show fallback icons for both locations
                    // Dropdown button
                    document.getElementById("userProfileImageDropdown").style.display = "none";
                    document.getElementById("userIconDropdown").style.display = "inline";

                    // Menu item
                    document.getElementById("userProfileImageMenu").style.display = "none";
                    document.getElementById("userIconMenu").style.display = "inline";
                });
        }


        function initializePhoneInput() {
            let phoneInputs = $(".country-phone-input");
            let errorMessage = $(".error-message");
            let countryCode = "bd"; // Default fallback
                        // --- Add custom CSS for .iti dynamically ---
            if (!document.getElementById("customIntlTelInputStyles")) {
                const style = document.createElement("style");
                style.id = "customIntlTelInputStyles";
                style.innerHTML = `
                    .iti {
                        position: relative !important;
                        display: flex !important;
                    }
                `;
                document.head.appendChild(style);
            }

            // Step 1: Try to fetch country code
            $.get("/Administration/GetCompanyDetails")
                .done(function (response) {
                    if (response.success && response.data && response.data.countryCode) {
                        countryCode = response.data.countryCode.toLowerCase();
                    }
                    // else keep "bd"
                })
                .fail(function (jqXHR, textStatus, errorThrown) {
                    console.warn("Failed to load company details. Using default country 'bd'.", textStatus, errorThrown);
                    // countryCode remains "bd"
                })
                .always(function () {
                    // Step 2: ALWAYS initialize intlTelInput, regardless of success/failure
                    if (phoneInputs.length) {
                        phoneInputs.each(function () {
                            let phoneInput = $(this);
                            let iti = window.intlTelInput(phoneInput[0], {
                                initialCountry: countryCode,
                                separateDialCode: true,
                                utilsScript: "https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.8/js/utils.js"
                            });

                            // Attach validation on form submit
                            phoneInput.closest("form").off("submit").on("submit", function (event) {
                                event.preventDefault();
                                validatePhoneNumber(iti, phoneInput, errorMessage);
                            });
                        });
                    }
                });
        }

            initializePhoneInput();

         function validatePhoneNumber(iti, phoneInput, errorMessage) {
            if (!iti.isValidNumber()) {
                errorMessage.removeClass("d-none");
                phoneInput.addClass("border-red-500");
            } else {
                errorMessage.addClass("d-none");
                phoneInput.removeClass("border-red-500");
            }
        }

        window.addEventListener('load', function() {
            let isfullscreen = localStorage.getItem('isFullScreen');
            if (isfullscreen === 'true') {
                ToggleFullScreen(true);
            }
        });

        (function () {
            let url = window.location.pathname;

            // ✅ normalize: lowercase + remove trailing slashes
            url = url.toLowerCase().replace(/\/+$/, "");

            let visits = JSON.parse(localStorage.getItem("visits")) || {};

            // Increment visit count
            visits[url] = (visits[url] || 0) + 1;

            // 🔒 Cap: keep only top 50 visited URLs
            let entries = Object.entries(visits)
                .sort((a, b) => b[1] - a[1]) // sort by frequency
                .slice(0, 50);               // keep top 50

            // Save back as object
            localStorage.setItem("visits", JSON.stringify(Object.fromEntries(entries)));
        })();


    </script>

    <script>
        // Side Menu Dropdown in navbar
        var featureIcons = {
            'Pre-Onboarding': 'hgi-graduate-male',
            'Onboarding': 'hgi-user-add-01',
            'Core HR': 'hgi-user-group',
            'Attendance & Leave': 'hgi-calendar-check-in-01',
            'Payroll & Finance': 'hgi-wallet-01',
            'Performance Management': 'hgi-star',
            'Learning & Development': 'hgi-book-open-01',
            'Manpower & Budgeting': 'hgi-chart-line-data-01',
            'Report': 'hgi-file-01',
            'OffBoarding': 'hgi-user-remove-01',
            'AI': 'hgi-magic-wand-01',
            'Setting & Configuration': 'hgi-settings-02',
            'OrganizationFlowchart': 'hgi-structure-01',
            'Process': 'hgi-flow-square'
        };

        function getFeatureIcon(name) {
            return featureIcons[name] || 'hgi-folder-02';
        }

        // Module logo image from wwwroot/module_logo/{FeatureName}.svg,
        // falls back to the hgi icon if the image is missing
        function getFeatureImg(name) {
            var src = '/module_logo/' + encodeURIComponent(name) + '.svg';
            return `<img src="${src}" alt="${name}" width="18" height="18"
                         class="mega-menu-feature-icon"
                         data-fallback="${getFeatureIcon(name)}">`;
        }

        function bindFeatureImgFallback(root) {
            root.find('img.mega-menu-feature-icon').each(function () {
                var $img = $(this);
                var fallback = function () {
                    $img.replaceWith('<i class="hgi hgi-stroke hgi-rounded ' + $img.data('fallback') + '"></i>');
                };
                if (this.complete && this.naturalWidth === 0) {
                    fallback();
                } else {
                    $img.on('error', fallback);
                }
            });
        }

        function renderSideMenu(permissions) {
            const $dropdown = $('#sideMenuDropdown');
            $dropdown.empty();

            var filtered = permissions.filter(function (p) {
                return p.isDisplay && p.view && p.featureName;
            });

            filtered.sort(function (a, b) {
                return (a.viewId || 0) - (b.viewId || 0);
            });

            var grouped = {};
            var order = [];
            filtered.forEach(function (p) {
                if (!grouped[p.featureName]) {
                    grouped[p.featureName] = [];
                    order.push(p.featureName);
                }
                grouped[p.featureName].push(p);
            });

            var html = `
                <div class="mega-menu-header">
                    <h6 class="mb-0 fw-bold"><i class="hgi hgi-stroke hgi-rounded hgi-grid-05 me-2"></i>Modules</h6>
                </div>
                <div class="mega-menu-body">`;

            order.forEach(function (feature) {
                html += `<div class="mega-menu-section">
                    <h6>${getFeatureImg(feature)} ${feature}</h6>
                    <div class="mega-menu-grid">`;
                grouped[feature].forEach(function (item) {
                    html += `<a class="mega-menu-link" href="/${item.controller}/${item.action}">
                        <p>${item.title}</p>
                    </a>`;
                });
                html += `</div></div>`;
            });

            html += '</div>';
            $dropdown.html(html);
            bindFeatureImgFallback($dropdown);
        }

        function loadNavbarMenu() {
            $.ajax({
                url: '/Home/GetUserPermissions',
                type: 'GET',
                success: function (permissions) {
                    renderSideMenu(permissions);
                },
                error: function () {
                    renderSideMenu([]);
                }
            });
        }

        document.addEventListener('DOMContentLoaded', function () {
            loadNavbarMenu();
        });
    </script>

