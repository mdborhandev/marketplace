<style>
    /* Floating draggable setup button */
    .setup-fab {
        position: fixed;
        right: 20px;
        bottom: 20px;
        z-index: 1050;
        width: 48px;
        height: 48px;
        border: 0;
        background: transparent;
        padding: 0;
        cursor: grab;
        touch-action: none;
        -webkit-user-select: none;
        user-select: none;
    }

    .setup-fab:active {
        cursor: grabbing;
    }

    .setup-fab-ring {
        --fab: 0%;
        width: 100%;
        height: 100%;
        border-radius: 50%;
        background: conic-gradient(var(--bs-primary) var(--fab), #3c4043 var(--fab));
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 .5rem 1.25rem rgba(0, 0, 0, .3);
    }

    .setup-fab-core {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: var(--bs-body-bg);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: .05rem;
        color: var(--bs-primary);
        font-size: .6rem;
        font-weight: 700;
        line-height: 1;
    }

    .setup-fab-core i {
        font-size: 1.15rem;
        line-height: 1;
    }

    .setup-fab-shortname {
        max-width: 30px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: .58rem;
        font-weight: 800;
        line-height: 1;
        text-transform: uppercase;
    }

    .setup-fab:hover .setup-fab-ring {
        transform: scale(1.05);
    }

    .setup-fab-ring {
        transition: transform .2s ease;
    }

    /* Wizard progress */
    .wizard-progress {
        height: 1.4rem;
        border-radius: 3rem;
        overflow: hidden;
        background: var(--bs-border-color);
        margin-bottom: .9rem;
    }

    .wizard-progress-bar {
        height: 100%;
        width: 0;
        min-width: 2.2rem;
        border-radius: 3rem;
        background: var(--bs-primary);
        transition: width .35s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: .7rem;
        font-weight: 700;
        line-height: 1;
        white-space: nowrap;
    }

    /* Arrow stepper */
    .wizard-steps {
        display: flex;
        align-items: center;
        overflow-x: auto;
        padding: .6rem .75rem;
        margin-bottom: .9rem;
        gap: 0;
        scrollbar-width: thin;
        scrollbar-color: color-mix(in srgb, var(--bs-primary) 30%, transparent) transparent;
    }

    .wizard-steps::-webkit-scrollbar { height: 4px; }
    .wizard-steps::-webkit-scrollbar-track { background: transparent; }
    .wizard-steps::-webkit-scrollbar-thumb { background: color-mix(in srgb, var(--bs-primary) 30%, transparent); border-radius: 3rem; }
    .wizard-steps::-webkit-scrollbar-thumb:hover { background: var(--bs-primary); }

    .wizard-step {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        min-height: 42px;
        padding: .55rem 1.5rem;
        font-size: .85rem;
        white-space: nowrap;
        border: 0;
        cursor: pointer;
        outline: none;
        transition: all .25s ease;
        color: var(--bs-secondary-color);
        background: var(--bs-tertiary-bg);
        clip-path: polygon(0 0, calc(100% - 20px) 0, 100% 50%, calc(100% - 20px) 100%, 0 100%, 20px 50%);
    }

    .wizard-step.active {
        background: var(--bs-primary);
        color: #fff;
    }

    .wizard-step.done {
        background: var(--bs-primary);
        color: #fff;
    }

    .wizard-step.skipped {
        background: color-mix(in srgb, var(--bs-secondary) 18%, transparent);
        color: var(--bs-secondary);
    }

    .wizard-step:not(.active):hover {
        background: color-mix(in srgb, var(--bs-primary) 10%, transparent);
        color: var(--bs-primary);
    }

    .wizard-step-icon {
        font-size: .95rem;
        line-height: 1;
        margin-left: .4rem;
        flex-shrink: 0;
    }

    .wizard-step-progress {
        font-size: .72rem;
        font-weight: 700;
        margin-left: .35rem;
        opacity: .9;
        flex-shrink: 0;
    }

    /* Step header */
    .wizard-step-desc {
        margin-bottom: .9rem !important;
        display: flex;
        align-items: center;
        gap: .4rem;
    }

    .wizard-step-head {
        display: flex;
        align-items: center;
        gap: .85rem;
        padding: .9rem 1rem;
        margin-bottom: 1rem;
        border-radius: .9rem;
        border: 1px solid var(--bs-border-color);
    }

    .wizard-step-head-icon {
        width: 46px;
        height: 46px;
        border-radius: .8rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        color: #fff;
        background: var(--bs-primary);
        box-shadow: 0 6px 14px color-mix(in srgb, var(--bs-primary) 30%, transparent);
        flex-shrink: 0;
    }

    .wizard-step-head-text {
        display: flex;
        flex-direction: column;
        min-width: 0;
        flex: 1;
    }

    .wizard-step-head-title {
        font-weight: 700;
        font-size: 1.05rem;
        line-height: 1.2;
    }

    .wizard-step-head-sub {
        font-size: .78rem;
        color: var(--bs-secondary-color);
    }

    .wizard-step-badge {
        flex-shrink: 0;
        padding: .3rem .7rem;
        border-radius: 3rem;
        font-size: .72rem;
        font-weight: 700;
        background: color-mix(in srgb, var(--bs-primary) 12%, transparent);
        color: var(--bs-primary);
    }

    .wizard-step-badge.all-done {
        background: color-mix(in srgb, var(--bs-primary) 14%, transparent);
        color: var(--bs-primary);
    }

    /* Wizard body */
    .wizard-task-list {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: .6rem;
    }

    .wizard-task-tabs {
        display: inline-flex;
        gap: .25rem;
        padding: .25rem;
        margin-bottom: .9rem;
        border-radius: .75rem;
        border: 1px solid var(--bs-border-color);
    }

    .wizard-task-tab {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .4rem .9rem;
        border: 0;
        border-radius: .55rem;
        font-size: .78rem;
        font-weight: 600;
        color: var(--bs-secondary-color);
        background: transparent;
        cursor: pointer;
        transition: all .2s ease;
    }

    .wizard-task-tab:hover {
        color: var(--bs-primary);
    }

    .wizard-task-tab.active {
        background: var(--bs-body-bg);
        color: var(--bs-primary);
        box-shadow: 0 1px 4px rgba(0, 0, 0, .08);
    }

    .wizard-task-tab .count {
        min-width: 20px;
        height: 20px;
        padding: 0 .4rem;
        border-radius: 3rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: .7rem;
        font-weight: 700;
        background: color-mix(in srgb, var(--bs-primary) 12%, transparent);
        color: var(--bs-primary);
    }

    .wizard-task-tab .hgi {
        font-size: .95rem;
        line-height: 1;
    }

    .wizard-task-group-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        gap: .4rem;
        padding: 1.6rem 1rem;
        border: 2px dashed var(--bs-border-color);
        border-radius: 1rem;
        color: var(--bs-secondary-color);
    }

    .wizard-task-group-empty i {
        font-size: 1.4rem;
        color: var(--bs-secondary);
    }

    /* Task cards */
    .setup-task {
        display: flex;
        align-items: center;
        gap: .7rem;
        padding: .7rem .8rem;
        border-radius: .8rem;
        border: 1px solid var(--bs-border-color);
        background: var(--bs-body-bg);
        transition: all .2s ease;
    }

    .setup-task:hover {
        border-color: color-mix(in srgb, var(--bs-primary) 50%, transparent);
        box-shadow: 0 6px 16px rgba(0, 0, 0, .06);
        transform: translateY(-1px);
    }

    .setup-task-status {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        line-height: 0;
        background: color-mix(in srgb, var(--bs-primary) 10%, transparent);
        color: var(--bs-primary);
        flex-shrink: 0;
    }

    .setup-task-status .hgi {
        font-size: 1.1rem;
        line-height: 1;
        display: block;
    }

    .setup-task-info {
        display: flex;
        flex-direction: column;
        min-width: 0;
        flex: 1;
        line-height: 1.25;
    }

    .setup-task-title {
        font-weight: 600;
        font-size: .88rem;
        color: var(--bs-body-color);
    }

    .setup-task-count {
        font-size: .74rem;
        color: var(--bs-secondary-color);
    }

    .setup-task-link {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.05rem;
        color: #fff;
        background: var(--bs-primary);
        text-decoration: none;
        flex-shrink: 0;
        transition: transform .2s ease;
    }

    .setup-task-link:hover {
        color: #fff;
        transform: scale(1.1);
    }

    .setup-task.done {
        border-color: color-mix(in srgb, var(--bs-primary) 50%, transparent);
        background: color-mix(in srgb, var(--bs-primary) 8%, transparent);
    }

    .setup-task.done .setup-task-status {
        background: color-mix(in srgb, var(--bs-primary) 15%, transparent);
        color: var(--bs-primary);
    }

    .setup-task.done .setup-task-link {
        display: none;
    }

    .setup-task.done .setup-task-count {
        color: var(--bs-primary);
    }

    .wizard-empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        gap: .6rem;
        padding: 3rem 1rem;
        border: 2px dashed var(--bs-border-color);
        border-radius: 1rem;
        color: var(--bs-secondary-color);
    }

    .wizard-empty-state i {
        font-size: 2.2rem;
        color: var(--bs-secondary);
    }

    /* Modal polish */
    #setupWizardModal .modal-content {
        border: 0;
        border-radius: 1.1rem;
        overflow: hidden;
    }

    #setupWizardModal .modal-header {
        border-bottom: 1px solid var(--bs-border-color);
        background: color-mix(in srgb, var(--bs-primary) 6%, transparent);
    }

    #setupWizardModal .modal-footer {
        justify-content: space-between;
        align-items: center;
        margin-top: 1.25rem;
        padding-top: 1rem;
        border-top: 1px solid var(--bs-border-color);
        background: var(--bs-body-bg);
    }

    #setupWizardModal .modal-footer .btn {
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        box-shadow: 0 2px 6px rgba(0, 0, 0, .08);
    }

    #setupWizardModal .modal-footer .btn-primary {
        box-shadow: 0 4px 12px color-mix(in srgb, var(--bs-primary) 35%, transparent);
    }

    #setupWizardModal .modal-footer .hgi {
        font-size: 1.05rem;
        line-height: 1;
    }

    #setupWizardModal .wizard-btn-soft-primary {
        background: color-mix(in srgb, var(--bs-primary) 10%, transparent);
        color: var(--bs-primary);
        border: 1px solid color-mix(in srgb, var(--bs-primary) 18%, transparent);
        transition: all .2s ease;
    }

    #setupWizardModal .wizard-btn-soft-primary:hover {
        background: color-mix(in srgb, var(--bs-primary) 18%, transparent);
        color: var(--bs-primary);
        border-color: color-mix(in srgb, var(--bs-primary) 25%, transparent);
    }
</style>

<!-- Floating draggable setup button -->
<button type="button" class="setup-fab d-none" id="setup-fab" title="Company Setup Wizard">
    <span class="setup-fab-ring" id="setup-fab-ring">
        <span class="setup-fab-core" id="setup-fab-core"></span>
    </span>
</button>

<!-- Setup Wizard -->
<div class="modal fade" id="setupWizardModal" tabindex="-1" aria-labelledby="setupWizardModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title mb-0" id="setupWizardModalLabel">Company Setup Wizard</h5>
                    <small class="text-muted" id="wizard-progress-desc"></small>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="wizard-progress"><div class="wizard-progress-bar" id="wizard-progress-bar"><span id="wizard-progress-label"></span></div></div>
                <div class="wizard-steps" id="wizard-steps"></div>
                <div class="wizard-step-desc text-muted small mb-2" id="wizard-step-desc"></div>
                <div id="wizard-step-body"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-3" id="wizard-prev">
                    <i class="hgi hgi-stroke hgi-circle-arrow-left-01 me-1"></i>Back
                </button>
                <div class="d-flex gap-2">
                    <button type="button" class="btn wizard-btn-soft-primary rounded-pill px-3" id="wizard-skip" title="Skip this step, you can complete it later">
                        Skip<i class="hgi hgi-stroke hgi-rounded hgi-arrow-right-01 ms-1"></i>
                    </button>
                    <button type="button" class="btn btn-primary rounded-pill px-4" id="wizard-next">
                        Next<i class="hgi hgi-stroke hgi-rounded hgi-arrow-right-01 ms-1"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        function initCompanySetupChecklist() {
            if (typeof $ === "undefined") {
                setTimeout(initCompanySetupChecklist, 100);
                return;
            }

            $(function () {
                if (localStorage.getItem("setupChecklistAllDone") === "true") {
                    return;
                }

                // --- Floating draggable button ---
                function getCookie(name) {
                    var v = document.cookie.match("(^|;)\\s*" + name + "\\s*=\\s*([^;]+)");
                    return v ? decodeURIComponent(v.pop()) : "";
                }

                var fab = document.getElementById("setup-fab");
                var dragging = false;
                var moved = 0;
                var offsetX = 0;
                var offsetY = 0;
                var shortName = getCookie("CompanyShortName") || "COM";

                var savedPos = localStorage.getItem("setupFabPos");
                if (savedPos) {
                    var p = savedPos.split(",");
                    fab.style.left = p[0] + "px";
                    fab.style.top = p[1] + "px";
                    fab.style.right = "auto";
                    fab.style.bottom = "auto";
                }

                fab.addEventListener("pointerdown", function (e) {
                    dragging = true;
                    moved = 0;
                    var r = fab.getBoundingClientRect();
                    offsetX = e.clientX - r.left;
                    offsetY = e.clientY - r.top;
                    fab.setPointerCapture(e.pointerId);
                });

                fab.addEventListener("pointermove", function (e) {
                    if (!dragging) return;
                    moved = Math.max(moved, Math.hypot(e.movementX || 0, e.movementY || 0));
                    var x = e.clientX - offsetX;
                    var y = e.clientY - offsetY;
                    fab.style.left = x + "px";
                    fab.style.top = y + "px";
                    fab.style.right = "auto";
                    fab.style.bottom = "auto";
                    localStorage.setItem("setupFabPos", x + "," + y);
                });

                function endDrag() {
                    if (!dragging) return;
                    dragging = false;
                    if (moved < 5) {
                        openWizard();
                    }
                }

                fab.addEventListener("pointerup", endDrag);
                fab.addEventListener("pointercancel", function () { dragging = false; });

                // --- Wizard (shared scope so the FAB can open it) ---
                var wizardStep = 0;
                var skippedSteps = {};
                var taskTab = "todo";
                var modules = [];
                var taskList = {};
                var hiddenTaskIds = ["onboardingChecklist", "resources", "documentTemplate", "commonData"];

                // --- Task target thresholds (how many records are needed to mark a task complete) ---
                // Values here are client-side defaults. When the server starts providing targets,
                // it can send them under `data.targets` and they will override these defaults.
                var DEFAULT_TARGETS = {
                    employee: 15,
                    dept: 1,
                    desig: 3,
                    grade: 1,
                    unit: 1,
                    line: 1,
                    floor: 1,
                    section: 1,
                    subsection: 1,
                    shift: 1,
                    bank: 1,
                    bankBranch: 1,
                    email: 1,
                    approval: 1,
                    docPrefix: 1,
                    weekdays: 1,
                    holiday: 1,
                    empWeekdays: 1,
                    fiscal: 1,
                    salarysetup: 1,
                    overtimeCalculation: 1,
                    salaryComponents: 2,
                    salaryTemplate: 1,
                    leave: 1,
                    emphremail: 1,
                    signatory: 1,
                    letterconfig: 1,
                    appraisalCycle: 1,
                    displayNames: 1,
                    ratingConfig: 1,
                    kraMaster: 1,
                    kpiMaster: 1,
                    skillMaster: 1,
                    applicableSkillType: 1,
                    kraExpectation: 1,
                    kraOutcome: 1,
                    goalExpectation: 1,
                    goalOutcome: 1,
                    skillExpectation: 1,
                    skillOutcome: 1,
                    competencyExpectation: 1,
                    competencyOutcome: 1,
                    disciplineExpectation: 1,
                    stamp: 1,
                    onboardingChecklist: 1,
                    resources: 1,
                    documentTemplate: 1,
                    verification: 1,
                    commonData: 1,
                    gender: 1,
                    religion: 1,
                    maritalStatus: 1,
                    employeeType: 1,
                    salaryGrade: 1,
                    designationGrade: 1,
                    degree: 1,
                    subject: 1,
                    institute: 1,
                    course: 1,
                    overtimeSettings: 1,
                    attendanceBonus: 1,
                    absentDeduction: 1,
                    allowanceVariable: 1,
                    allowanceTemplate: 1,
                    salaryIncrement: 1,
                    increment: 1,
                    offboardingChecklist: 1,
                    handoverTemplate: 1,
                    releaseType: 1,
                    budgeting: 1,
                    requisition: 1,
                    questionTemplate: 1,
                    learningtraining: 1,
                    careerPath: 1,
                    learningAssessment: 1
                };

                var serverTargets = null;
                function getTarget(id) {
                    if (serverTargets && serverTargets[id] != null && !isNaN(serverTargets[id]) && serverTargets[id] > 0) {
                        return serverTargets[id];
                    }
                    return DEFAULT_TARGETS[id] != null ? DEFAULT_TARGETS[id] : 1;
                }

                function buildTaskChip(task) {
                    var doneClass = task.completed ? " done" : "";
                    var statusIcon = task.completed ? "hgi hgi-stroke hgi-rounded hgi-checkmark-circle-01" : "hgi hgi-stroke hgi-rounded hgi-circle";
                    var actionLink = task.completed
                        ? ""
                        : `<a href="${task.link}" class="setup-task-link" title="Open"><i class="hgi hgi-stroke hgi-rounded hgi-arrow-up-right-01"></i></a>`;
                    var countHtml = task.completed
                        ? `<span class="setup-task-count">Completed</span>`
                        : `<span class="setup-task-count">${task.count} of ${task.target} done</span>`;

                    return `
                        <div class="setup-task${doneClass}">
                            <span class="setup-task-status"><i class="${statusIcon}"></i></span>
                            <span class="setup-task-info">
                                <span class="setup-task-title">${task.text}</span>
                                ${countHtml}
                            </span>
                            ${actionLink}
                        </div>
                    `;
                }

                function renderWizardSteps() {
                    var html = "";
                    modules.forEach(function (module, i) {
                        var hasTasks = module.tasks.length > 0;
                        var isDone = hasTasks && module.tasks.every(function (t) { return t.completed; });
                        var isSkipped = !!skippedSteps[module.id];
                        var cls = i === wizardStep
                            ? " active"
                            : (isDone ? " done" : (isSkipped ? " skipped" : ""));

                        var doneCount = hasTasks ? module.tasks.filter(function (t) { return t.completed; }).length : 0;
                        var iconHtml = isDone
                            ? '<i class="hgi hgi-stroke hgi-rounded hgi-checkmark-circle-01 wizard-step-icon"></i>'
                            : "";
                        var progressHtml = hasTasks
                            ? `<span class="wizard-step-progress">${doneCount}/${module.tasks.length}</span>`
                            : "";

                        html += `<button type="button" class="wizard-step${cls}" data-step="${i}" title="${module.title}">${module.title}${iconHtml}${progressHtml}</button>`;
                    });
                    $("#wizard-steps").html(html);
                }

                function renderWizardStepBody() {
                    var module = modules[wizardStep];
                    var isSkipped = !!skippedSteps[module.id];
                    var isLast = wizardStep === modules.length - 1;
                    var moduleTodo = module.tasks.filter(function (t) { return !t.completed; }).length;
                    var moduleDone = module.tasks.filter(function (t) { return t.completed; }).length;

                    $("#wizard-step-desc").text(
                        "Step " + (wizardStep + 1) + " of " + modules.length +
                        (module.tasks.length ? " · " + moduleTodo + " task(s) remaining" : "") +
                        (isSkipped ? " · marked as skipped" : "")
                    );

                    var body = `
                        <div class="wizard-step-head">
                            <span class="wizard-step-head-icon"><i class="hgi hgi-stroke ${module.icon || "hgi-settings-02"}"></i></span>
                            <span class="wizard-step-head-text">
                                <span class="wizard-step-head-title">${module.title}</span>
                                <span class="wizard-step-head-sub">${module.tasks.length ? "Setup checklist for this module" : "No checklist defined yet"}</span>
                            </span>
                            ${module.tasks.length
                                ? `<div class="wizard-task-tabs mb-0">
                                    <button type="button" class="wizard-task-tab${taskTab === "todo" ? " active" : ""}" data-tab="todo"><i class="hgi hgi-stroke hgi-task-01"></i>To Do <span class="count">${moduleTodo}</span></button>
                                    <button type="button" class="wizard-task-tab${taskTab === "done" ? " active" : ""}" data-tab="done"><i class="hgi hgi-stroke hgi-rounded hgi-checkmark-circle-01"></i>Done <span class="count">${moduleDone}</span></button>
                                </div>`
                                : `<span class="wizard-step-badge">Not configured</span>`}
                        </div>`;

                    if (module.tasks.length === 0) {
                        body += `
                            <div class="wizard-empty-state">
                                <i class="hgi hgi-stroke hgi-folder-02"></i>
                                <div class="fw-semibold">No setup tasks yet</div>
                                <div class="small">The ${module.title} module has no checklist defined. You can configure it from its own module section anytime.</div>
                            </div>
                        `;
                    } else {
                        var todoTasks = module.tasks.filter(function (t) { return !t.completed; });
                        var doneTasks = module.tasks.filter(function (t) { return t.completed; });

                        var todoHtml = todoTasks.length
                            ? `<div class="wizard-task-list">` + todoTasks.map(buildTaskChip).join("") + `</div>`
                            : `<div class="wizard-task-group-empty"><i class="hgi hgi-stroke hgi-rounded hgi-checkmark-circle-01"></i><span class="small fw-semibold">Nothing to do here</span></div>`;
                        var doneHtml = doneTasks.length
                            ? `<div class="wizard-task-list">` + doneTasks.map(buildTaskChip).join("") + `</div>`
                            : `<div class="wizard-task-group-empty"><i class="hgi hgi-stroke hgi-task-01 ml-auto"></i><span class="small fw-semibold">No completed tasks yet</span></div>`;

                        body += `
                            <div class="wizard-task-group${taskTab === "todo" ? "" : " d-none"}" id="wizard-tasks-todo">${todoHtml}</div>
                            <div class="wizard-task-group${taskTab === "done" ? "" : " d-none"}" id="wizard-tasks-done">${doneHtml}</div>
                        `;
                    }
                    if (isSkipped) {
                        body += '<div class="alert alert-secondary py-2 small mt-2 mb-0"><i class="hgi hgi-stroke hgi-forward-02 me-1"></i>This step was skipped. You can return to it anytime.</div>';
                    }

                    $("#wizard-step-body").html(body);

                    $("#wizard-prev").toggleClass("invisible", wizardStep === 0);
                    $("#wizard-next").html(isLast ? 'Finish<i class="hgi hgi-stroke hgi-rounded hgi-checkmark-circle-01 ms-1"></i>' : 'Next<i class="hgi hgi-stroke hgi-rounded hgi-arrow-right-01 ms-1"></i>');
                    $("#wizard-skip").toggleClass("invisible", isLast || moduleTodo === 0);
                }

                function updateWizardProgress() {
                    var tasks = Object.keys(taskList)
                        .filter(function (id) { return hiddenTaskIds.indexOf(id) === -1; })
                        .map(function (id) { return taskList[id]; });
                    var completed = tasks.filter(function (t) { return t.completed; }).length;
                    var total = tasks.length;
                    var pct = total === 0 ? 0 : Math.round((completed / total) * 100);
                    $("#wizard-progress-bar").css("width", pct + "%");
                    $("#wizard-progress-label").text(shortName + " · " + pct + "% completed");
                    $("#wizard-progress-desc").text("Completed " + completed + " of " + total + " setup steps · " + pct + "%");
                }

                function wizardGoTo(step) {
                    if (step < 0 || step > modules.length - 1) return;
                    wizardStep = step;
                    renderWizardSteps();
                    renderWizardStepBody();
                    updateWizardProgress();
                }

                function isModulePending(module) {
                    return module.tasks.some(function (t) { return !t.completed; });
                }

                function firstPendingStep() {
                    for (var i = 0; i < modules.length; i++) {
                        if (isModulePending(modules[i])) return i;
                    }
                    return 0;
                }

                function nextPendingStep() {
                    for (var i = wizardStep + 1; i < modules.length; i++) {
                        if (isModulePending(modules[i])) return i;
                    }
                    return -1;
                }

