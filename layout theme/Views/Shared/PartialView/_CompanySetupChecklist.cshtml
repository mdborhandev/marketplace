                    $("#wizard-tasks-done").toggleClass("d-none", tab !== "done");
                });

                $("#wizard-prev").on("click", function () {
                    wizardGoTo(wizardStep - 1);
                });

                $("#wizard-next").on("click", function () {
                    var next = nextPendingStep();
                    if (next === -1) {
                        bootstrap.Modal.getInstance(document.getElementById("setupWizardModal")).hide();
